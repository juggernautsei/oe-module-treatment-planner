{% extends "treatment/base.html.twig" %}

{% block treatment_content %}
    <div class="container treatment-plan-container">
        <div class="row">
            <div class="col-12">
                <h2>{{ "Create Treatment Plan"|xlt }}</h2>

                {% if error %}
                    <div class="alert alert-danger">
                        {{ error|xlt }}
                    </div>
                {% endif %}

                {% if plan %}
                    <div class="alert alert-success">
                        {{ "Treatment plan generated successfully!"|xlt }}
                        <a href="{{ webroot }}/interface/modules/custom_modules/{{ module_name }}/public/index.php/treatment/edit?id={{ plan.id }}" class="btn btn-primary btn-sm ml-2">
                            {{ "Edit Plan"|xlt }}
                        </a>
                        <a href="{{ webroot }}/interface/modules/custom_modules/{{ module_name }}/public/index.php/treatment/view?id={{ plan.id }}" class="btn btn-info btn-sm">
                            {{ "View Plan"|xlt }}
                        </a>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3>{{ "Generated Treatment Plan"|xlt }}</h3>

                        </div>
                        <div class="card-body">
                            <div class="treatment-content">
                                {{ plan.content|nl2br }}
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        {{ "Generated with"|xlt }} {{ plan.metadata.model|text }} |
                                        {{ "Tokens used"|xlt }}: {{ plan.metadata.total_tokens|text }}
                                    </small>
                                </div>
                                <div class="col-md-6 text-right">
                                    <small class="text-info">
                                        <i class="fas fa-info-circle"></i>
                                        {{ "Review and edit the draft before submitting it for approval"|xlt }}
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <form method="post" action="" id="observation-form">
                        <input type="hidden" name="csrf_token_form" value="{{ csrf_token_form|attr }}">
                        <input type="hidden" name="request_key" value="{{ request_key|attr }}">
                        <input type="hidden" name="pid" value="{{ pid|attr }}">
                        <input type="hidden" name="encounter" value="{{ encounter|attr }}">
                        <input type="hidden" name="assessment_fingerprint" value="{{ assessment_fingerprint|default('')|attr }}">
                        {% if assessment_preview|default([]) %}
                        <section class="card my-3"><div class="card-body">
                          <h3>{{ 'Assessment readiness'|xlt }}</h3>
                          <p>{{ 'Using the latest saved assessment in this encounter'|xlt }}: {{ assessment_preview.source.form|text }} — {{ assessment_preview.source.date|text }}</p>
                          <p>{{ 'Recorded input is not independently verified. The AI must not invent missing information.'|xlt }}</p>
                          {% if assessment_preview.missing %}<div class="alert alert-warning">{{ 'Missing or uncertain information'|xlt }}: {{ assessment_preview.missing|join(', ')|text }}</div>
                          <label><input type="checkbox" name="acknowledge_missing" value="1" {% if acknowledge_missing|default(false) %}checked{% endif %}> {{ 'I reviewed these gaps and will verify the draft against the chart before approval.'|xlt }}</label>
                          {% else %}<p>{{ 'The configured key assessment fields contain documented values. This is a completeness check, not a clinical validation.'|xlt }}</p>{% endif %}
                          <details><summary>{{ 'Review recorded source inputs before generation'|xlt }}</summary>
                          <table class="table table-sm"><thead><tr><th>{{ 'Reference'|xlt }}</th><th>{{ 'Assessment field'|xlt }}</th><th>{{ 'Recorded value'|xlt }}</th></tr></thead><tbody>
                          {% for source in assessment_preview.sources %}<tr><td>[{{ source.reference|text }}]</td><td>{{ source.label|text }} ({{ source.source_field|text }})</td><td>{{ source.value|text }}</td></tr>{% endfor %}
                          </tbody></table></details>
                        </div></section>
                        {% endif %}


                        <div class="form-group">
                            <label for="observations">{{ "Clinical Observations & Additional Notes"|xlt }}</label>

                            <!-- Voice Controls Container -->
                            <div id="voice-controls" class="mb-2" style="display: none;">
                                <button type="button" id="voice-button" class="btn btn-secondary btn-sm" title="{{ 'Click to start voice input'|xlt }}">
                                    🎤 {{ "Voice Input"|xlt }}
                                </button>
                                <button type="button" id="ai-button" class="btn btn-primary btn-sm ml-2" title="{{ 'Improve text with AI'|xlt }}">
                                    {{ "Revise with AI"|xlt }}
                                </button>
                            </div>

                            <textarea class="form-control" id="observations" name="observations" rows="8"
                                      placeholder="{{ 'Enter any additional clinical observations, notes, or specific treatment considerations not captured in the assessment form...'|xlt }}">{{ observations|text }}</textarea>
                            <small class="form-text text-muted">
                                {{ "The treatment plan will be generated based on the patient's assessment data and diagnoses. Add any additional observations or specific treatment preferences here."|xlt }}
                            </small>
                        </div>

                        <div class="form-group mt-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <button type="submit" name="submit_observations" value="1" class="btn btn-primary">
                                        {{ "Generate Treatment Plan"|xlt }}
                                    </button>
                                    <a href="{{ webroot }}/interface/modules/custom_modules/{{ module_name }}/public/index.php/dashboard" class="btn btn-secondary">
                                        {{ "Return to Dashboard"|xlt }}
                                    </a>
                                </div>
                                <div class="col-md-6 text-right">
                                    <a href="{{ webroot }}/interface/modules/custom_modules/{{ module_name }}/public/index.php/treatment/list?pid={{ pid }}" class="btn btn-info">
                                        {{ "View Patient Plans"|xlt }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const notes = document.getElementById('observations');
        const form = document.getElementById('observation-form');
        if (!notes || !form) { return; }
        // A native textarea works across OpenEMR versions without editor assets.
        document.getElementById('voice-controls').style.display = 'block';
        const voiceButton = document.getElementById('voice-button');
        const aiButton = document.getElementById('ai-button');
        voiceButton.addEventListener('click', function() {
            if (!('webkitSpeechRecognition' in window)) {
                alert('{{ "Voice recognition not supported in this browser."|xlt|js_escape }}');
                return;
            }
            const recognition = new webkitSpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';
            voiceButton.disabled = true;
            recognition.onresult = function(event) {
                for (let i = event.resultIndex; i < event.results.length; i++) {
                    if (event.results[i].isFinal) {
                        notes.setRangeText(event.results[i][0].transcript + ' ', notes.selectionStart, notes.selectionEnd, 'end');
                    }
                }
            };
            recognition.onerror = function() {
                voiceButton.disabled = false;
                alert('{{ "Voice recognition error. Please try again."|xlt|js_escape }}');
            };
            recognition.onend = function() { voiceButton.disabled = false; };
            recognition.start();
            setTimeout(function() { recognition.stop(); }, 30000);
        });
        aiButton.addEventListener('click', async function() {
            const original = notes.value;
            if (!original.trim()) {
                alert('{{ "Please enter some text to revise."|xlt|js_escape }}');
                return;
            }
            aiButton.disabled = true;
            try {
                const response = await fetch('{{ webroot }}/interface/modules/custom_modules/{{ module_name }}/public/index.php/treatment/revise', {
                    method: 'POST',
                    body: new URLSearchParams({
                        csrf_token_form: form.querySelector('[name="csrf_token_form"]').value,
                        pid: form.querySelector('[name="pid"]').value,
                        encounter: form.querySelector('[name="encounter"]').value,
                        text: original
                    })
                });
                const data = await response.json();
                if (!response.ok || typeof data.content !== 'string' || !data.content.trim()) {
                    throw new Error('Revision failed');
                }
                // Do not replace notes typed while the request was in flight.
                if (notes.value !== original) {
                    alert('{{ "Notes changed while revising. Your current notes were kept."|xlt|js_escape }}');
                    return;
                }
                notes.value = data.content;
            } catch (error) {
                alert('{{ "AI revision failed. Your notes were kept."|xlt|js_escape }}');
            } finally {
                aiButton.disabled = false;
            }
        });
        form.addEventListener('submit', function() {
            const submitButton = form.querySelector('[name="submit_observations"]');
            if (submitButton) { submitButton.setAttribute('aria-busy', 'true'); }
        });
    });
    </script>
{% endblock %}
