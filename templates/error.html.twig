{% extends 'base.twig' %}

{% block title %}
    {{ 'Error'|xlt }}
{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="alert alert-danger">
                <h4><i class="fa fa-exclamation-triangle"></i> {{ 'Error'|xlt }}</h4>
                <p>{{ error|text }}</p>
            </div>
            
            <div class="mt-3">
                <a href="{{ webroot }}/interface/modules/custom_modules/oe-module-treatment-planner/public/index.php/dashboard" class="btn btn-primary">
                    <i class="fa fa-arrow-left"></i> {{ 'Back to Dashboard'|xlt }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
