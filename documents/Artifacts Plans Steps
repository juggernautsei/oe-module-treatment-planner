public function addHealthScribeEncItem(LoadEncounterFormFilterEvent $event)
{
    // Add treatment planner form to encounter
    if ($event->getFormName() === 'treatment_planner') {
        $event->setDir($GLOBALS['fileroot'] . '/interface/modules/custom_modules/oe-module-treatment-planner/');
        $event->setPageName('encounter/treatment.php');
    }
    return $event;
}
